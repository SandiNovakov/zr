[sub_resource type="GDScript" id="GDScript_jyhfs"]
script/source = "extends Camera2D

@onready var player: Actor2D = get_parent()

var boost_tween: Tween
var default_zoom: Vector2 = Vector2.ONE
var boost_zoom: Vector2 = Vector2(1.1, 1.1)

func _ready() -> void:
    player.boost_charge_started.connect(on_boost_charge_started)
    player.boost_charge_ended.connect(on_boost_charge_ended)

func on_boost_charge_started() -> void:
    if boost_tween:
        boost_tween.kill()

    boost_tween = create_tween()
    boost_tween.tween_property(self, \"zoom\", boost_zoom, player.boost_charge_time)\\
        .set_trans(Tween.TRANS_CUBIC)\\
        .set_ease(Tween.EASE_OUT)
        #.set_trans(Tween.TRANS_CIRC)\\
       # .set_ease(Tween.EASE_OUT_IN)
    
func on_boost_charge_ended() -> void:
    if boost_tween:
        boost_tween.kill()

    boost_tween = create_tween()
    boost_tween.tween_property(self, \"zoom\", default_zoom, 0.3)\\
        .set_trans(Tween.TRANS_BACK)\\
        .set_ease(Tween.EASE_OUT)
"

