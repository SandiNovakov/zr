[sub_resource type="GDScript" id="GDScript_ht77c"]
script/source = "extends Label

var accum: float = 0.0
var frames: int = 0

func _process(delta: float) -> void:
    accum += delta
    frames += 1

    if accum >= 0.5:
        var fps: float = frames / accum
        text = \"FPS: %d\" % int(fps)
        accum = 0.0
        frames = 0
"

