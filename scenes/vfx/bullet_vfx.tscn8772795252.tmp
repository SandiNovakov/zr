[sub_resource type="GDScript" id="GDScript_m1adn"]
script/source = "extends Sprite2D

func _ready() -> void:
    randomize()
    var possible_sprites: Array[int] = [
        31,
        33,
        35,
        37,
        40
    ]
    
    var index: int = randi() % possible_sprites.size()
    frame = possible_sprites[index]
    
    #var tween = create_tween()
    #tween.tween_property(self, \"modulate:a\", 0.0, 0.1)
    #tween.tween_callback(queue_free)
    
    var tween: Tween = create_tween()
    tween.tween_property(self, \"modulate\", Color(1.0, 0.55, 0.1, 0.0), 0.1).set_trans(Tween.TRANS_CUBIC).set_ease(Tween.EASE_IN)
    tween.tween_callback(queue_free)
"

