[sub_resource type="GDScript" id="GDScript_klc8q"]
script/source = "extends GPUParticles2D

@export var color_start: Color = Color.WHITE
@export var color_middle: Color = Color.WHITE
@export var color_end: Color = Color.WHITE

func _ready() -> void:
    process_material.color_ramp.gradient = Util.make_3point_gradient(
        color_start,
        color_middle,
        color_end,
        1.0,
        1.0,
        0.0
    )

    finished.connect(queue_free)
    one_shot = true
    restart()
"

