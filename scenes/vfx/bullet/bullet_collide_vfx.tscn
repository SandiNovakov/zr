[sub_resource type="GDScript" id="GDScript_klc8q"]
script/source = "extends GPUParticles2D

@export var color_start: Pallete.Colors
@export var color_middle: Pallete.Colors
@export var color_end: Pallete.Colors

func _ready() -> void:
    if color_start != null and color_middle != null and color_end != null:
        process_material.color_ramp.gradient = Util.make_3point_gradient(
            Pallete.get_color(color_start),
            Pallete.get_color(color_middle),
            Pallete.get_color(color_end),
            1.0,
            1.0,
            0.0
        )
    
    finished.connect(queue_free)
    one_shot = true
    restart()
"

[node name="BulletCollideVfx" type="GPUParticles2D" unique_id=2023029930]
