[sub_resource type="GDScript" id="GDScript_o6xl0"]
script/source = "extends ProgressBar

var player: Actor2D
var internal_value: int

func _ready() -> void:
    player = GlobalRef.get_player()
    if player:
        max_value = player.max_health
        internal_value = player.health
        value = internal_value
        
        if player:
            player.damaged.connect(_shake)
        

func _shake() -> void:
    var original_position := position
    var shake := create_tween()
    
    modulate = Color(1.0, 0.498, 0.498, 1.0)

    var tween := create_tween()
    tween.set_ease(Tween.EASE_OUT)
    tween.tween_property(self, \"modulate\", Color.WHITE, 0.08)
    
    shake.set_trans(Tween.TRANS_SINE)
    shake.tween_property(self, \"position\", original_position + Vector2(6, 6), 0.025)
    shake.tween_property(self, \"position\", original_position + Vector2(-6, -4), 0.025)
    shake.tween_property(self, \"position\", original_position + Vector2(4, 6), 0.025)
    
    shake.finished.connect(func(): position = original_position)

func _process(delta: float) -> void:
    if not player:
        player = GlobalRef.get_player()
        if player:
            player.damaged.connect(_shake)
        return   
    
    if internal_value != player.health:
        internal_value = player.health

    value = move_toward(value, internal_value, max_value * delta)
"

[sub_resource type="GDScript" id="GDScript_85g3d"]
script/source = "extends RichTextLabel

var display: int = 0
var main: Node

func _process(delta: float) -> void:
    if not main:
        main = GlobalRef.get_main()
        return
    
    if display != main.score:
        display = move_toward(display, main.score, 1000 * delta)
    
    var score_text := str(display).lpad(12, \"0\")
    var zero_count := 12 - str(display).length()

    text = \"[color=#ffffff80]%s[/color]%s\" % [
        score_text.left(zero_count),
        score_text.substr(zero_count)
    ]
        
"

