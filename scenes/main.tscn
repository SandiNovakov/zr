[sub_resource type="GDScript" id="GDScript_sgp6g"]
script/source = "extends Node

var score: int = 0

func _ready() -> void:
    GlobalRef.register_ref(&\"main\", self)
    Input.set_mouse_mode(Input.MOUSE_MODE_HIDDEN)
    Settings.apply_settings()

func update_score(amount) -> void:
    score += amount

    var score_label: Label = $\"UI/MarginContainer/Control/VBoxContainer/Score+\"
    score_label.text = \"+%s\" % amount
    score_label.modulate.a = 1.0

    var tween := create_tween()
    tween.set_ease(Tween.EASE_IN)
    tween.tween_property(score_label, \"modulate:a\", 0.0, 1)
"

