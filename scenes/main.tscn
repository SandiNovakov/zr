[sub_resource type="GDScript" id="GDScript_ya4ey"]
script/source = "extends ProgressBar

var player: Actor2D

var target: Node2D

func _ready() -> void:
    player = GlobalRef.get_player()
    visible = false
    modulate.a = 0.0

func _process(delta: float) -> void:
    if not player:
        player = GlobalRef.get_player()
        visible = false
        return
    
    if player.lock_on and \"max_health\" in player.lock_on:
        target = player.lock_on
        
        if visible == false:
            visible = true
            max_value = target.max_health
            value = target.health
            
            var tween := create_tween()
            tween.set_ease(Tween.EASE_OUT)
            tween.tween_property(self, \"modulate:a\", 1.0, 0.08)
        
        global_position = target.get_global_transform_with_canvas().origin
        global_position -= Vector2(64, 96)
        
        max_value = target.max_health
        if value != target.health:
            value = move_toward(value, target.health, max_value * 2 * delta)
        
        return
    
    if visible:
        visible = false
        
        var tween := create_tween()
        tween.set_ease(Tween.EASE_OUT)
        tween.tween_property(self, \"modulate:a\", 0.0, 0.08)
"

